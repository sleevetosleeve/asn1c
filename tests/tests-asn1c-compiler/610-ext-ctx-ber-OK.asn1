
-- Phase 0 (BER/CER) regression module for -fno-ctx-members (issue #15):
-- a SEQUENCE with an inline CHOICE of three SEQUENCE alternatives.

NetMsg DEFINITIONS AUTOMATIC TAGS ::= BEGIN

NetWorldRequest ::= SEQUENCE { x INTEGER, flag BOOLEAN }
NetWorldState   ::= SEQUENCE { tick INTEGER }
NetCharacterInput ::= SEQUENCE { key INTEGER }

NetMsg ::= SEQUENCE {
    id   INTEGER,
    body CHOICE {
        worldRequest   NetWorldRequest,
        worldState     NetWorldState,
        characterInput NetCharacterInput
    }
}

-- Aliasing regression for the external arena: the single inline member
-- sits at offset 0, so the child structure shares the parent's base address.
Wrap ::= SEQUENCE { only SEQUENCE { v INTEGER } }

END
